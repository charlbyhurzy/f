#
# Repository-wide ignore rules for the Futura Audio Android + native C++
# project. Covers build outputs, Gradle/IDE caches, signing secrets,
# native build artefacts, third_party dependency clones, OS cruft, and
# log files. Kept in the repository root so both :app and :engine
# modules inherit it automatically.

.gradle/
