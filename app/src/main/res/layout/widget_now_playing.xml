<?xml version="1.0" encoding="utf-8"?>
<!--
    RemoteViews layout for the Futura Audio "Now Playing" homescreen widget.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_alarm_icon"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:contentDescription="@string/widget_cd_alarm_indicator"
            android:src="@drawable/ic_alarm" />

        <TextView
            android:id="@+id/widget_alarm_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingStart="4dp"
            android:paddingEnd="8dp"
            android:text="@string/widget_alarm_armed_default"
            android:textColor="#00FF66"
            android:textSize="9sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/widget_battery_icon"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:contentDescription="@string/widget_cd_battery_indicator"
            android:src="@drawable/ic_battery" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="8dp">

        <ImageView
            android:id="@+id/widget_album_art"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="#1A1F26"
            android:contentDescription="@string/widget_cd_album_art"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/widget_track_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_track_title_placeholder"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_track_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingTop="2dp"
                android:text="@string/widget_track_artist_placeholder"
                android:textColor="#00E5FF"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/widget_btn_prev"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/widget_cd_btn_prev"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_prev"
                android:tint="#FFFFFF" />

            <ImageButton
                android:id="@+id/widget_btn_play_pause"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/widget_cd_btn_play_pause"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_play"
                android:tint="#00FF66" />

            <ImageButton
                android:id="@+id/widget_btn_next"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/widget_cd_btn_next"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_next"
                android:tint="#FFFFFF" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
